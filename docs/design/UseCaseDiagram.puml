@startuml
left to right direction

actor Customer
actor Agent
actor "Biller Company" as Biller
actor Admin
actor "Support Employee" as Support

rectangle "PayLink System" {

    usecase "Register Account" as UC1
    usecase "Upgrade Verification" as UC2
    usecase "View Wallet Balance" as UC3
    usecase "View Transaction History" as UC4
    usecase "Top Up Wallet" as UC5

    usecase "View Available Billers" as UC6
    usecase "Check Bill Inquiry" as UC7
    usecase "Pay a Bill" as UC8
    usecase "Receive Payment Result" as UC9
    usecase "Receive Payment Notifications" as UC10
    usecase "Request Refund" as UC11

    usecase "Pay Bills for Customers" as UC12
    usecase "Receive Agent Commission" as UC13

    usecase "Manage Billers and Services" as UC14
    usecase "Update Fees and Limits" as UC15
    usecase "View Daily Business Totals" as UC16

    usecase "Search Payment Details" as UC17
    usecase "Block / Unblock Accounts" as UC18
    usecase "Approve Refund Requests" as UC19
    usecase "View Reconciliation Report" as UC20

    usecase "Provide Bill Information" as UC21
    usecase "Receive Bill Payments" as UC22
    usecase "Send Payment Confirmation" as UC23
